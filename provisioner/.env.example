# Provisioner runtime env. Copy to the deploy host as provisioner.env next to docker-compose.prod.yml
# (that path is what the compose service's env_file points at) and fill every value.
#
# There are no defaults here except the port. Every other setting names a target (which socket, which
# image, which network) or a safety cap (memory, CPU, pids), and a provisioner that guessed one of
# those would quietly create unbounded containers from the wrong image on the wrong network. It
# refuses to boot instead, naming the setting.

# Bearer token the backend presents on every call. Minimum 32 characters — this is the ENTIRE
# authentication story between the backend and the process holding the Docker socket. Generate with:
#   openssl rand -hex 32
# The same value goes in stewra.env as HOSTED_RUNNER_PROVISIONER_TOKEN.
PROVISIONER_TOKEN=

# The Docker Engine socket, as seen INSIDE the provisioner container (compose bind-mounts the host's
# socket at the same path).
DOCKER_SOCKET=/var/run/docker.sock

# The exact repository:tag every runner container is created from. A floating tag is rejected — the
# template must pin what it runs. Requests naming any other image are refused before any Docker call,
# so a compromised backend cannot run an arbitrary image with the runner volumes attached.
#
# The image MUST declare its non-root user at build time (`USER runner`, see runner/Dockerfile).
# CapDrop ALL denies CAP_SETUID, so an image that drops privilege in its entrypoint (setpriv/su-exec/
# gosu) will not start. Build it on the host:
#   docker build -f runner/Dockerfile -t stewra-runner:<version> .
RUNNER_IMAGE=stewra-runner:0.1.0

# The isolated network from deploy/hosted-runner/create-network.sh. Must match RUNNER_NETWORK_NAME in
# deploy/hosted-runner/network.env, and that network must be fenced by iptables-egress.sh.
RUNNER_NETWORK=stewra_runners

# Per-container hard caps. Memory is also the swap cap (hosted runners get no swap headroom).
# 2 GiB, 2.0 CPUs, 512 processes — enough for a node toolchain plus a coding agent, bounded enough
# that one user's runaway build cannot take the host down.
RUNNER_MEMORY_BYTES=2147483648
RUNNER_NANO_CPUS=2000000000
RUNNER_PIDS_LIMIT=512

# Listen port. A behaviour knob, not a target: the service publishes no ports and is reachable only
# from the backend over the internal compose network.
PROVISIONER_PORT=3050
