# cp .env.example .env — REQUIRED before any build, including a local Release build.
#
# src/services/config.ts throws when either base is missing, and Expo inlines these into the JS
# bundle at build time. So a build made with no `.env` produces an app that loads NO UI: in debug you
# get the red box, but in Release there is no red box, so it is a plain BLACK SCREEN with nothing in
# the device log (all native modules register fine — the throw is in JS). If a Release build comes up
# black, check this file first. Changing a value needs a rebuild, not just a restart.

# REST API origin, no trailing slash. Point it at whichever backend the build should talk to:
#   local backend      http://localhost:3000        (simulator; use http://10.0.2.2:3000 on an
#                                                    Android emulator, which can't see the host's
#                                                    localhost)
#   production         https://www.stewra.com/api
# In production the `/api` prefix IS required: nginx fronts the backend under /api and strips it
# before proxying, so a base without the prefix 404s every request. Against a local backend there is
# no nginx and no prefix. The Maestro e2e suite needs the production value — its QA users only exist
# in the production database (see TESTING.md).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Socket.IO base. Use the SAME value as the REST base above, prefix included:
# src/services/socket.ts splits it into origin + `/api/socket.io/` path (see resolveSocketTarget) so
# that nginx routes the handshake to the backend's /socket.io/ mount.
EXPO_PUBLIC_WS_BASE_URL=http://localhost:3000

# The one subscription product this build sells, per store. Apple's and Play's product ids are
# issued independently and need not match, so there are two.
#
# These MUST equal the backend's APPLE_STORE_PRODUCT_ID / GOOGLE_PLAY_PRODUCT_ID. The server
# refuses a claim for any other product, so a mismatch is a purchase the customer pays for and
# cannot use — and neither store will tell you, because from their side the sale succeeded.
#
# Unlike the two bases above, a missing value here does NOT stop the app booting: a build with no
# store products is still a perfectly good chat client. It throws when the Subscription screen is
# opened instead, which is the first moment the value is actually needed.
EXPO_PUBLIC_STORE_PRODUCT_ID_IOS=
EXPO_PUBLIC_STORE_PRODUCT_ID_ANDROID=

# EAS project id for the Expo project that owns builds + push credentials
# (@nurturinglab/stewra). Created by `eas init`; visible on the EAS dashboard.
# app.config.ts reads it into extra.eas.projectId, which the push registration
# passes to getExpoPushTokenAsync. Required for Expo push + EAS builds.
EAS_PROJECT_ID=
