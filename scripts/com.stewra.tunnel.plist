<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keeps the Stewra dev tunnels (Postgres 127.0.0.1:5433, Redis :6379 -> home) alive.

  Why: the forwards ride the `home` ControlMaster, and ~/.ssh/config's `ControlPersist 600`
  kills that master 10 minutes after the last SSH session closes - taking the forwards with it.
  Re-running scripts/tunnel.sh every 5 minutes opens a session (the Redis docker-IP lookup),
  which resets the ControlPersist timer and re-creates any forward that died (sleep, roaming).
  The script is idempotent by design - "safe to run twice" per its own header.

  PATH is explicit because launchd agents don't inherit a shell PATH, and the `home`
  ProxyCommand (~/.ssh/ssh-home-proxy.sh) needs tailscale/cloudflared from /opt/homebrew/bin.

  The agent runs a HOME-DIRECTORY COPY of scripts/tunnel.sh, not the repo file: the repo lives on
  an exFAT removable volume (/Volumes/charan), and macOS TCC denies launchd agents access to
  removable volumes ("Operation not permitted", exit 126). ~/Library has no such gate.
  Consequence: after editing scripts/tunnel.sh, re-run the install below to refresh the copy.

  Install (from the repo root):
    mkdir -p ~/Library/Application\ Support/Stewra
    cp scripts/tunnel.sh ~/Library/Application\ Support/Stewra/tunnel.sh
    cp scripts/com.stewra.tunnel.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.stewra.tunnel.plist
  Remove:
    launchctl bootout gui/$(id -u)/com.stewra.tunnel
  Log: ~/Library/Logs/stewra-tunnel.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stewra.tunnel</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/robinstyle/Library/Application Support/Stewra/tunnel.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!-- tunnel.sh's job is to LEAVE a process behind: the `ssh -N -f` ControlMaster that carries
         the forwards. Without this key, launchd reaps the job's whole process group when the
         script exits, killing that master instantly - the tunnels then only survive when a master
         already existed outside the job (e.g. from a manual shell). -->
    <key>AbandonProcessGroup</key>
    <true/>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>/Users/robinstyle/Library/Logs/stewra-tunnel.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/robinstyle/Library/Logs/stewra-tunnel.log</string>
</dict>
</plist>
