# Backend env (copy to backend/.env). NEVER commit real secrets.
NODE_ENV=development
PORT=3001

# Dev DB = remote Postgres (container on home:/media/WDHD/docker) reached via SSH tunnel:
#   npm run tunnel    # local 5433 -> home:127.0.0.1:5433
DATABASE_URL=postgresql://stewra:CHANGE_ME@127.0.0.1:5433/stewra

# Auth
JWT_SECRET=CHANGE_ME_min_32_chars_long_secret_value_here
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# Vault (AES-256-GCM key, 64 hex chars = 32 bytes). Generate: openssl rand -hex 32
VAULT_KEY=CHANGE_ME_64_hex_chars

# Error tracking (GlitchTip on the remote; optional in M0)
SENTRY_DSN=

# Where the website runs — used for the CORS origin and the post-OAuth redirect back to the app.
WEB_APP_URL=http://localhost:5173

# Outbound email (Mailu/SMTP) used to send the 6-digit verification code. SMTP_SECURE=true means
# implicit TLS on port 465. On the host these come from backend/.mailcredentials (mode 600, gitignored).
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@stewra.com
SMTP_PASSWORD=CHANGE_ME
EMAIL_FROM=Stewra <no-reply@stewra.com>

# Email-verification policy. Codes expire after TTL minutes; a code locks out after MAX_ATTEMPTS wrong
# tries; a user must wait RESEND_COOLDOWN seconds between requesting new codes.
EMAIL_VERIFICATION_TTL_MINUTES=15
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Password-reset policy — same shape and defaults as verification above, separately tunable.
# PASSWORD_RESET_TTL_MINUTES=15
# PASSWORD_RESET_MAX_ATTEMPTS=5
# PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60

# Google OAuth (read-only Calendar + Gmail). One consent grants both. Create an OAuth client at
# https://console.cloud.google.com/apis/credentials and set the redirect URI to match below.
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=http://localhost:3001/connections/google/callback

# Optional Google tunables — all have safe defaults; override per deploy. Scopes are comma-separated.
# ⚠️ The default is NO LONGER read-only: it is calendar.readonly + gmail.readonly + gmail.modify +
# gmail.send, because Stewra archives/labels/replies AFTER the user confirms each action. Widening or
# narrowing them here is a visible, auditable change (never hardcoded in app code). REQUIRED_SCOPES is
# the canonical set a connection must have GRANTED to run the proactive assistant — a connection
# missing any of them is flagged `needsReconsent` and the user is asked to re-approve.
# CONSENT_PROMPT is the plain-language copy shown before the Google redirect (never a raw scope list).
# CALENDAR_LOOKAHEAD_DAYS is how far ahead the calendar is scanned (1..30); MAX_EVENTS/MAX_EMAILS cap
# how many raw records are pulled before minimizing to facts.
# GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar.readonly,https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/gmail.send
# GOOGLE_REQUIRED_SCOPES=https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/gmail.send
# GOOGLE_CONSENT_PROMPT=Allow Stewra to read your Google Calendar and Gmail, and — only when you tap Confirm — ...
# GOOGLE_CALENDAR_LOOKAHEAD_DAYS=7
# GOOGLE_MAX_EVENTS=50
# GOOGLE_MAX_EMAILS=20

# How many days back Gmail is pulled by default when a user hasn't chosen their own window.
# Users override this per-account in the app (stored as a preference); bounded to 1..90.
GMAIL_LOOKBACK_DAYS=7

# ── Email sync, briefing, and the learning loop ─────────────────────────────────────────────────────
# All optional with bounded defaults. They shape cost and prompt size, not correctness — a wrong value
# is rejected at boot by the schema's min/max rather than silently accepted.
#
# Full-body sync. RETENTION_DEFAULT_DAYS is the deploy fallback window when a user has set no
# per-user `email_retention_days`; BACKFILL_MAX_MESSAGES caps one backfill pass; BACKFILL_PAGE_SIZE is
# the Gmail list page size (max 500); SYNC_MAX_RETRIES bounds exponential backoff on transient errors.
# EMAIL_RETENTION_DEFAULT_DAYS=90
# EMAIL_BACKFILL_MAX_MESSAGES=2000
# EMAIL_BACKFILL_PAGE_SIZE=100
# EMAIL_SYNC_MAX_RETRIES=5
#
# Briefing shaping: how many "you owe a reply" threads become nudges per run, and how many recent
# messages feed the model's briefing context.
# BRIEFING_MAX_NUDGES=8
# BRIEFING_CONTEXT_MESSAGES=30
# The background scheduler that syncs mail + rebuilds each connected user's briefing on a tick. OFF by
# default so a dev box or test run never spins one up unexpectedly; enable it per deploy.
# BRIEFING_SCHEDULE_ENABLED=false
# BRIEFING_INTERVAL_MINUTES=180
#
# The opt-in Sent-mail style observer (only runs after the user opts in). MAX_SAMPLES/LOOKBACK_DAYS
# bound the read; MIN_SUPPORT/MIN_SHARE gate when a pattern is confident enough to surface as a
# PROPOSED rule — never auto-applied. High thresholds keep proposals high-precision.
# SENT_MAIL_MAX_SAMPLES=40
# SENT_MAIL_LOOKBACK_DAYS=90
# SENT_MAIL_MIN_SUPPORT=5
# SENT_MAIL_MIN_SHARE=0.6
#
# Recall knobs. MEMORY_* controls how many past-success exemplars are injected into a new task's
# prompt and the minimum full-text relevance a memory must clear. PROCESS_MEMORY_* controls the "how
# this user likes it done" style profile: how many active rules are injected, how far a rating moves a
# rule's confidence, and the WEAK negative reward for a dismiss-without-rating (0 disables that
# implicit signal and keeps dismiss telemetry-only).
# MEMORY_RECALL_LIMIT=3
# MEMORY_RECALL_MIN_RANK=0.01
# PROCESS_MEMORY_RECALL_LIMIT=12
# PROCESS_MEMORY_CONFIDENCE_STEP=5
# PROCESS_MEMORY_IMPLICIT_DISMISS_REWARD=-0.5

# Model provider. Default 'claude_cli' shells out to the locally installed `claude` CLI using your
# existing Claude Code subscription — no API key needed. Alternatives: anthropic | openai | gemini | grok.
MODEL_PROVIDER=claude_cli
# The locally installed `claude` CLI is auto-PREFERRED over MODEL_PROVIDER whenever it is actually
# runnable on this host (it uses your existing subscription — no API key, no per-token cost), which
# makes MODEL_PROVIDER the FALLBACK for hosts without it (e.g. the prod container). Set this to false
# to honour MODEL_PROVIDER verbatim — useful to exercise an API path on a machine that has the CLI.
# MODEL_PREFER_CLAUDE_CLI=true
# Path/name of the Claude Code binary (only used by claude_cli).
CLAUDE_CODE_PATH=claude
# Model id. Optional for claude_cli (uses your own configured model); REQUIRED for every API provider.
MODEL_ID=
# Optional override for the OpenAI-compatible base URL (proxies/gateways/regions).
MODEL_BASE_URL=
# Only the selected provider's key is required. Names match the product_advisor backend env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=

# ── Realtime / Messaging / Calls / Voice ────────────────────────────────────────────────────────────
# Redis is REQUIRED (backs the Socket.IO adapter for cross-instance fan-out + the presence store).
# Local dev: a local container (docker run -p 6379:6379 redis) or the SSH tunnel to home's Redis.
REDIS_URL=redis://127.0.0.1:6379
# Channel/key prefix for the Socket.IO Redis adapter. Every backend instance sharing a prefix forms ONE
# broadcast cluster. The default matches the adapter's own, which is fine when Redis is dedicated to
# this stack (it is, in docker-compose.prod.yml). Set a distinct prefix if you ever point two
# deployments at one Redis — otherwise they silently cross-relay each other's socket events.
# SOCKET_IO_ADAPTER_KEY=socket.io
# Presence liveness. A user is "online" while they hold ≥1 socket whose heartbeat is newer than
# STALE_MS; each instance re-stamps its live sockets every REFRESH_MS. This is what makes presence
# self-healing — a crashed instance stops re-stamping, so its sockets age out instead of pinning the
# user "online" forever. STALE_MS must be ≥ 2× REFRESH_MS; the backend refuses to boot otherwise.
# PRESENCE_STALE_MS=60000
# PRESENCE_REFRESH_MS=20000

# Audio/video calling. Master switch; when false the /calls routes 503 and signaling stays unwired, so a
# dev box without coturn isn't blocked. When true, TURN_URLS/TURN_SECRET/TURN_REALM are REQUIRED (fail
# loud). Reuses the coturn already on `home` with a DISTINCT Stewra realm + static-auth-secret — see
# deploy/coturn-stewra.md. Force-relay (comma-separated turns: URLs), so calls fail loud, never degrade.
CALLS_ENABLED=false
# TURN_URLS=turns:turn.stewra.com:5349?transport=tcp
# TURN_SECRET=CHANGE_ME_stewra_realm_static_auth_secret
# TURN_REALM=stewra.com
# TURN_CRED_TTL_SECONDS=3600

# Background ringing push credentials — all OPTIONAL (ringing degrades to in-app when unset). APNs
# VoIP/PushKit for iOS; an FCM service-account JSON string for Android data pushes.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNS_KEY_P8=
# FCM_SERVICE_ACCOUNT_JSON=

# Talk-to-Stewra voice (local STT/TTS). Master switch; when false /messages/voice 503s so a dev box
# without whisper.cpp/Piper isn't blocked. When true, WHISPER_BIN/WHISPER_MODEL/PIPER_BIN/PIPER_VOICE/
# FFMPEG_BIN/UPLOADS_DIR are REQUIRED. Binaries are invoked via execFile (no shell), config-driven paths.
VOICE_ENABLED=false
# In the prod image these tools are baked into /opt/voice by backend/Dockerfile (INSTALL_VOICE=true) and
# ffmpeg is apt-installed; set VOICE_ENABLED=true + these exact paths in stewra.env. Locally, point them
# at your own builds. ffmpeg normalizes recorded clips (Opus/webm/ogg) to the WAV whisper.cpp needs.
# WHISPER_BIN=/opt/voice/bin/whisper-cli
# WHISPER_MODEL=/opt/voice/models/ggml-base.en.bin
# PIPER_BIN=/opt/voice/piper/piper
# PIPER_VOICE=/opt/voice/piper-voices/en_US-amy-medium.onnx
# FFMPEG_BIN=/usr/bin/ffmpeg
# Where uploaded/synthesized media is written (a mounted volume in prod). Served ONLY via the
# authenticated GET /media/:id — never statically/publicly. MAX_UPLOAD_BYTES caps a clip (default 25 MB).
UPLOADS_DIR=/data/uploads
MAX_UPLOAD_BYTES=26214400

# ── WhatsApp channel (Meta's OFFICIAL Cloud API) ────────────────────────────────────────────────────
# Lets a user talk to Stewra from their own WhatsApp app by messaging STEWRA'S BUSINESS NUMBER — the way
# they'd message an airline. Stewra never touches the user's WhatsApp account, cannot read their other
# chats, and cannot get them banned.
#
# This is the DEFAULT and RECOMMENDED path, and nothing in this section ever logs into a user's account.
# A companion-device client (Baileys-style) that logs into the USER'S OWN WhatsApp is a separate,
# experimental, opt-in channel — see WHATSAPP_PERSONAL_* below — and per build-plan principle 7 it runs
# on the user's own machine and NEVER on Stewra's servers. No Baileys credential, socket, or dependency
# may ever land in the backend.
#
# Master switch. When false, /channels/whatsapp and the webhook 503, so a dev box without a Meta app is
# not blocked. When true, all five values below are REQUIRED (fail loud at boot).
WHATSAPP_ENABLED=false
# Meta's numeric id for the sender number (NOT the number itself). Meta gives you a free TEST number
# immediately — no business verification, no payment — which is enough to build and e2e this.
# WHATSAPP_PHONE_NUMBER_ID=
# Stewra's business number, E.164 WITHOUT the '+', used to build the user's wa.me link.
# WHATSAPP_BUSINESS_NUMBER=15550001111
# A Meta SYSTEM-USER token (never expires). A temp token from the dashboard dies in ~24h — never ship one.
# WHATSAPP_ACCESS_TOKEN=
# Our own random string, echoed back during Meta's GET webhook handshake. Generate: openssl rand -hex 24
# WHATSAPP_VERIFY_TOKEN=
# The Meta APP SECRET — keys the X-Hub-Signature-256 HMAC that authenticates every inbound webhook.
# Without it the webhook would accept a forged POST from anyone who guessed the URL.
# WHATSAPP_APP_SECRET=
# Graph API version, pinned per deploy (Meta deprecates versions on a schedule).
# WHATSAPP_GRAPH_VERSION=v21.0
# Graph API origin. Defaults to the real Meta endpoint; override only to drive the channel end-to-end
# against a local stand-in, or through a regional/proxied Graph endpoint — a config change, not a code one.
# WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
# How long a link code stays valid. Short by design — it's a possession proof, not a password.
# WHATSAPP_LINK_CODE_TTL_MINUTES=10
#
# ⚠️ COST: replies inside the 24h customer-service window are FREE today, but Meta begins charging for
# service messages on 2026-10-01 (per-message, no volume tiers; rates published 2026-09-01). Every
# Stewra WhatsApp reply becomes a metered cost from that date — re-check before scaling this on.

# ── Meta app for the COMMERCE plane (per-tenant WhatsApp via Embedded Signup) ────────────────────────
#
# A DIFFERENT Meta app from the WHATSAPP_* one above. That app owns Stewra's OWN business number and one
# system-user token for the whole install. This one owns nothing and sends nothing — it is the Tech
# Provider app through which each CLIENT connects THEIR OWN WhatsApp Business Account, and every
# credential it obtains is stored per-organization in the vault, never here.
#
# Do not point both at the same app id: the permissions differ (whatsapp_business_management,
# whatsapp_business_messaging, business_management), App Review is separate, and one revocation would
# otherwise take down the personal assistant and every client at once.
#
# ⚠️ Going live to real clients needs Meta TECH PROVIDER status plus App Review — weeks of lead time,
# applied for outside this repo. Until then this works against a Meta test WABA in dev mode.
#
# Master switch. When false the commerce connect routes and /webhooks/meta 503. When true, the four
# values below are REQUIRED (fail loud at boot).
META_COMMERCE_ENABLED=false
# The Meta app id. Sent to the browser to launch the Embedded Signup dialog — public by nature.
# META_COMMERCE_APP_ID=
# The app secret. Keys the X-Hub-Signature-256 HMAC on /webhooks/meta and signs the server-side code
# exchange. Without it the webhook cannot tell Meta from anyone who guessed the URL.
# META_COMMERCE_APP_SECRET=
# The Embedded Signup configuration id — which flow Meta shows the connecting client. Created in the
# app dashboard; NOT derivable from the app id.
# META_COMMERCE_CONFIG_ID=
# Echoed back during Meta's GET webhook handshake. Your own random string, and DIFFERENT from
# WHATSAPP_VERIFY_TOKEN so the two webhooks cannot be cross-verified.
# META_COMMERCE_VERIFY_TOKEN=
# Graph API version, pinned per deploy (Meta deprecates versions on a schedule).
# META_COMMERCE_GRAPH_VERSION=v21.0
# Graph API origin. Override only to drive the connect flow against a local stand-in, or through a
# regional/proxied Graph endpoint.
# META_COMMERCE_GRAPH_BASE_URL=https://graph.facebook.com
#
# ── Commerce job worker (migration 043) ─────────────────────────────────────────────────────────
# The durable queue that carries scheduled and retryable commerce work. All three knobs describe how
# hard the worker polls, not what it acts on, so all three are safely defaulted.
#
# There is deliberately NO enable/disable switch: the worker starts with the rest of the commerce
# plane. A deploy that enqueues without draining looks healthy — every enqueue succeeds — while the
# work silently piles up, which is the failure this queue was built to replace.
#
# How often a worker looks for due jobs.
# COMMERCE_WORKER_POLL_MS=5000
# How many jobs one pass claims. The batch runs sequentially, so this also bounds how long a single
# pass can take: batch x slowest handler.
# COMMERCE_WORKER_BATCH_SIZE=5
# How long a claim is held before another worker may take the job over. Must comfortably exceed the
# slowest handler — a lease that expires under a running job means that job runs twice, which is why
# handlers are required to be idempotent.
# COMMERCE_WORKER_LEASE_SECONDS=300
#
# ⚠️ COST: WhatsApp went per-message on 2025-07-01. Marketing templates are ~$0.025/message in the US
# with no volume discount, and free-form service replies start being charged 2026-10-01. Client-facing
# pricing has to be decided before broadcasts ship, or they sell at a loss.

# ── WhatsApp PERSONAL — EXPERIMENTAL companion device (a SECOND, separate channel) ──────────────────
#
# ⚠️ READ THIS BEFORE SETTING IT TO true.
#
# Everything above is Meta's OFFICIAL Cloud API: users message Stewra's business number, and no user's
# WhatsApp account is ever at risk. This is the other thing. It links the user's OWN WhatsApp account as
# a companion device, which is unofficial, against WhatsApp's terms, and CAN GET THAT ACCOUNT
# PERMANENTLY BANNED. Bans are usually not reversible, and for most people their phone number is also
# their identity for bank codes and 2FA.
#
# It is off by default, gated behind an acknowledgement the user must TYPE OUT, and — per build-plan
# principle 7 — the WhatsApp client itself runs in the Stewra Bridge app on the USER'S OWN COMPUTER.
# There is deliberately no WhatsApp credential in this file for it: the backend never connects to
# WhatsApp, never holds a session, and cannot be made to.
WHATSAPP_PERSONAL_ENABLED=false
# Where users download the Stewra Bridge app. REQUIRED when enabled — no default, because guessing a
# download URL for a security-sensitive desktop binary is not a thing we should ever do quietly.
# The /runner page on this deployment hosts the Bridge downloads too.
# WHATSAPP_PERSONAL_DOWNLOAD_URL=https://www.stewra.com/runner
# Oldest bridge build allowed to connect. REQUIRED when enabled. This is a SAFETY control: if a shipped
# bridge turns out to reconnect too aggressively, the accounts it burns are our users' real accounts,
# and this is the lever that stops an old build spreading the damage.
# WHATSAPP_PERSONAL_MIN_BRIDGE_VERSION=1.0.0
# Hard ceiling on outbound sends. Send volume is the single biggest driver of WhatsApp bans, so keep
# this low — it protects the user's account, it is not a throughput tunable.
# WHATSAPP_PERSONAL_MAX_SENDS_PER_MINUTE=10
# How long forwarded WhatsApp message bodies are kept before the retention sweep deletes them.
# WHATSAPP_PERSONAL_RETENTION_DAYS=30
# Raw entropy of a bridge DEVICE credential, in bytes. A bridge token is long-lived and deliberately
# NOT a JWT — it carries no expiry, because revocation is by database row, which is immediate.
# WHATSAPP_PERSONAL_BRIDGE_TOKEN_BYTES=32

# ── WhatsApp EMAIL-APPROVAL (approve-to-send email over WhatsApp) ───────────────────────────────────
# A THIRD, independent switch, in its own namespace ON PURPOSE so it can never be turned on as a side
# effect of enabling either WhatsApp channel above. When false, the per-user opt-in cannot be enabled
# and both WhatsApp channels keep their draft-and-defer refusal (they will never send mail for you).
#
# When true, FCM_SERVICE_ACCOUNT_JSON (above) is REQUIRED and the backend refuses to boot without it.
# Android is the only shipped push surface, and the actionable Approve/Deny prompt is delivered as a
# raw FCM v1 DATA-ONLY message — without that credential the prompt silently never reaches the phone,
# leaving the feature advertised but inert, which is worse than not booting.
WHATSAPP_EMAIL_APPROVAL_ENABLED=false
# Expo push access token — authorizes THIS backend to send through Expo's push service under Expo's
# "Enhanced Security" (which rejects unauthenticated sends). OPTIONAL: it backs only the DEFERRED iOS
# path (iOS → Expo → APNs), so it is not in the required-when-enabled set until iOS ships. Distinct
# from the call-ring APNs/FCM credentials above.
# EXPO_ACCESS_TOKEN=

# ── Stewra RUNNER (coding agents on the user's OWN machine) ─────────────────────────────────────────
# An opt-in surface where the user runs coding agents (Claude Code, Codex, Gemini CLI) on their own
# laptop or cloud VM and drives them from Stewra. Its own namespace, like every WhatsApp switch above,
# so enabling any of those can never enable this one as a side effect. When false, the `/runner` socket
# namespace is not mounted and every runner REST route reports the feature unavailable.
RUNNER_ENABLED=false
# Where users download the Stewra Runner. REQUIRED when enabled — same reasoning as the bridge's
# download URL: guessing a URL for a binary that executes code is not a thing we do quietly.
# RUNNER_DOWNLOAD_URL=https://www.stewra.com/runner
# Oldest runner build allowed to connect. REQUIRED when enabled. A SAFETY control, not housekeeping:
# a runner executes code on the user's machine, and this is the lever to refuse a build whose
# execution path we no longer trust. NB: the shipped runner is 0.1.0 — setting this above the
# published version rejects every real runner at pairing.
# RUNNER_MIN_VERSION=0.1.0
# Newest published runner build. REQUIRED when enabled. Advertised to connecting runners and the web
# "Runners" panel so out-of-date devices surface an upgrade notice (notify-only; the runner never
# replaces its own binary). Must be >= RUNNER_MIN_VERSION — the backend refuses to boot otherwise.
# RUNNER_LATEST_VERSION=0.1.0
# Raw entropy of a runner DEVICE credential, in bytes (long-lived, not a JWT; revoked by database row).
# RUNNER_DEVICE_TOKEN_BYTES=32
# How long a single-use pairing code stays valid before it expires.
# RUNNER_PAIR_CODE_TTL_MINUTES=10

# ── Stewra GITHUB APP (click-through repo access for the HOSTED runner) ─────────────────────────────
# Registered once by the operator (permissions: contents read/write, pull_requests write; Setup URL:
# https://<your-web-origin>/github/setup). Users click-install it on chosen repositories; the backend
# stores only the installation id and mints short-lived (≤1h) installation tokens on demand — no
# long-lived user git credential is ever at rest on Stewra. The three GITHUB_APP_* keys are
# all-or-nothing: setting some but not all refuses to boot, and setting none disables the surface.
# Numeric App ID from the App's settings page.
# GITHUB_APP_ID=
# The App's URL slug — the <slug> in https://github.com/apps/<slug>.
# GITHUB_APP_SLUG=
# The App's private key .pem, base64-wrapped for env transport: `base64 -w0 < stewra.private-key.pem`.
# GITHUB_APP_PRIVATE_KEY_BASE64=
# GitHub REST endpoint. A protocol endpoint like WHATSAPP_GRAPH_BASE_URL above, so it carries the one
# value it can carry; override only for GitHub Enterprise Server.
# GITHUB_API_BASE_URL=https://api.github.com

# ── HOSTED RUNNERS (the cloud-first path: Stewra runs the coding-agent container itself) ─────────────
# With this on, a user clicks "set up cloud runner" and Stewra provisions a hardened container on this
# host — no binary to install. Off by default and its own switch, so a deploy that offers the laptop
# runner never starts creating containers because a neighbouring feature was enabled.
#
# Turning it on REQUIRES, and refuses to boot without: RUNNER_ENABLED=true (the /runner namespace the
# container dials into), a fully configured GitHub App above (how the container gets repositories), and
# the four settings below. Host prerequisites — the provisioner service, its isolated Docker network,
# and the egress firewall — are in deploy/hosted-runner/ and runner/HOSTED.md.
HOSTED_RUNNER_ENABLED=false
# Where the provisioner answers. It is the only process holding the Docker socket and publishes no
# ports; this is its name on the internal compose network, reachable from the backend and nothing else.
# HOSTED_RUNNER_PROVISIONER_URL=http://provisioner:3050
# Bearer token for the provisioner — the ENTIRE authentication story between this backend and a process
# that can create containers on the host. Minimum 32 characters; must be byte-identical to
# PROVISIONER_TOKEN in provisioner.env. Generate with: openssl rand -hex 32
# HOSTED_RUNNER_PROVISIONER_TOKEN=
# The exact repository:tag to provision. Sent verbatim and REJECTED by the provisioner unless it matches
# that service's own RUNNER_IMAGE — so a compromised backend cannot choose what its containers run.
# HOSTED_RUNNER_IMAGE=stewra-runner:0.1.0
# The PUBLIC origin a hosted runner dials back on (it reaches Stewra exactly as any client does). Must
# be the public origin, not an internal name: a wrong value produces containers that boot, fail to
# connect, and look like an image fault.
# HOSTED_RUNNER_API_URL=https://api.stewra.com
# How long a cloud runner may sit idle before its container is stopped to free the host. The volumes —
# the cloned repositories and any work on them — are never touched, and the next session wakes it, so
# this is a cost knob rather than a data one. 0 disables idle-stop entirely.
# HOSTED_RUNNER_IDLE_STOP_MINUTES=60
# How long a session start waits for a woken container to actually CONNECT (not merely to be running)
# before failing the session with `runner_wake_timeout`.
# HOSTED_RUNNER_WAKE_TIMEOUT_SECONDS=90
