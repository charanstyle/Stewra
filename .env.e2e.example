# Stewra E2E — single source of QA credentials for BOTH suites (Playwright web + Maestro mobile).
#
#   cp .env.e2e.example .env.e2e && chmod 600 .env.e2e   # .env.e2e is GITIGNORED — only this template is tracked
#   # then fill in the two QA users below
#
# The web suite (website/e2e) loads this file directly; the Maestro wrappers
# (frontend/e2e/run-features.sh) source it. Real environment variables always win
# over this file, so CI can inject the same names without a file.
#
# The two users MUST be mutual contacts and email-verified — a `direct` conversation
# only exists between contacts, and every page sits behind email verification.
# These are DEDICATED QA ACCOUNTS: tests run against production (there is no separate
# dev DB), so never point these at a real user.

# Where the site lives. API is same-origin under /api unless E2E_API_URL overrides it.
E2E_WEB_URL=https://www.stewra.com
# E2E_API_URL=            # optional; defaults to $E2E_WEB_URL/api

# QA user A (the caller in web call tests; default actor for API helpers).
E2E_USER_A_EMAIL=user-a@example.com
E2E_USER_A_PASSWORD=

# QA user B (the callee; must be a contact of A).
E2E_USER_B_EMAIL=user-b@example.com
E2E_USER_B_PASSWORD=

# Mobile-only: which conversation the Maestro flows open, given as the contact's DISPLAY NAME exactly
# as it appears in the chat list.
#
# Blank means "the top thread", which is NOT a useful default here: the "Stewra" AI-assistant thread
# is pinned to the top of every chat list, so a blank value always opens the assistant instead of a
# human conversation. run-two-party-message.sh therefore REQUIRES both names and fails loudly if
# either is unset, rather than silently messaging the assistant and reporting delivery as broken.
#
# Quote any value containing spaces: the shell wrappers parse this file as dotenv, but quoting keeps
# it unambiguous for both readers.
#   E2E_CONTACT_NAME="QA Web B"
E2E_CONTACT_NAME=
# B's view of A — used by run-two-party-message.sh to open A's thread on device B.
#   E2E_CONTACT_NAME_A="QA Web A"
E2E_CONTACT_NAME_A=

# Business name used by the mobile flows/create-org.yaml when the account has no organization yet.
# Only consumed on that first run — once the account owns an org the flow skips creating one, so
# changing this value later does not rename anything. The flow fails loudly if it is unset rather
# than submitting an empty name.
#   E2E_ORG_NAME="QA E2E Business"
E2E_ORG_NAME=

# OPTIONAL runner target for the opt-in coding-agent E2E (web: website/e2e/tests/runner.spec.ts —
# auto-discovers an online machine and skips if none; mobile: flows/optional/runner-session.yaml —
# needs these three, since Maestro can't discover them). Set them to a runner you've paired and left
# ONLINE (`npx @stewra/runner pair <code>`). Use the exact names GET /runner/devices reports.
#   E2E_RUNNER_MACHINE=work-laptop
#   E2E_RUNNER_WORKSPACE=stewra
#   E2E_RUNNER_HARNESS=Claude Code
E2E_RUNNER_MACHINE=
E2E_RUNNER_WORKSPACE=
E2E_RUNNER_HARNESS=

# Optional 16 kHz mono WAV fed to WebRTC as fake mic input so speech-to-text
# produces a real transcript in the voice-to-text spec.
# E2E_AUDIO_FILE=

# OPTIONAL real mailbox for the UI sign-up test (auth.spec.ts). The site emails a 6-digit
# code, and the only honest way to type it into /verify-email is to read the mail a user
# would read: the maildir is fetched over ssh with `docker exec`. Each run plus-addresses a
# fresh sender off this one mailbox (needs Mailu's RECIPIENT_DELIMITER=+).
#
# Leave unset for a normal run — the sign-up test then skips, and every run leaves one real
# account behind. (Until migration 062 that account was PERMANENT: `audit_log` references
# `users` with ON DELETE SET NULL and the append-only trigger rejected that UPDATE. Accounts
# are deletable now — website/e2e/tests/accountDeletion.spec.ts proves it on the live site and
# needs none of these three, because deletion is not gated on email verification.)
#
# Setting the mailbox makes the other two REQUIRED (no defaults — an ssh host and a
# container name must never be guessed).
# E2E_SIGNUP_MAILBOX=qa-e2e@stewra.com
# E2E_SIGNUP_SSH_HOST=home
# E2E_SIGNUP_IMAP_CONTAINER=mailu-imap-1

# Skip budget enforced by website/e2e/skip-reporter.mjs. Set to the EXACT number of
# legitimately conditional skips (see TESTING.md): more fails the run, and so does
# fewer — a budget wider than reality is room a regression can skip in unnoticed.
# Unset = report-only census. A real environment variable overrides this file.
E2E_MAX_SKIPS=4

# OPTIONAL direct Postgres URL, used ONLY to provision the destructive-but-reversible
# lifecycle tests (Today nudge actions + Memory delete) — see website/e2e/seed.mjs.
# Leave unset for a normal run: those tests then skip instead of running. When set, the
# suite stages real rows (a throwaway memory; a few of A's nudges flipped to `open`) and
# undoes them afterward (snapshot/restore; delete the throwaway). This is prod data — the
# action tests still write honest, append-only audit_log entries that are not rewritten.
# Point it at the same DB the API uses (e.g. via an ssh tunnel to the prod Postgres).
# You should not need to set this by hand: `npm run test:e2e:seeded` (website/e2e/with-prod-db.sh)
# brings up the tunnel, reads the URL off the deploy host and exports it for one command, so the
# password is never written into a file. Set it here only if you have a DB this script cannot find.
# E2E_DATABASE_URL=postgres://user:pass@127.0.0.1:5433/stewra
