# Stewra E2E credentials — QA accounts created through the real UI by
# website/e2e/bootstrap-qa-users.mjs. Tracked in git by explicit owner decision
# (2026-08-13) so the QA credentials cannot be lost again — these guard only the
# dedicated QA accounts. Do NOT add E2E_DATABASE_URL or any production secret here;
# pass those as environment variables instead.
# Mail for both lands in the qa-e2e@stewra.com Mailu mailbox via plus-addressing.
E2E_WEB_URL=https://www.stewra.com
E2E_USER_A_EMAIL=qa-e2e+q3a@stewra.com
E2E_USER_A_PASSWORD=Qa-jwna9wOg-QOiWil4-9
E2E_USER_B_EMAIL=qa-e2e+q3b@stewra.com
E2E_USER_B_PASSWORD=Qa-v1GlFqsuuu44np3A-9
E2E_CONTACT_NAME=QA Web B
# A's display name as it appears in B's chat list (bootstrap-qa-users.mjs seeds it);
# required by the two-party mobile runners so B opens the human conversation, not the
# pinned Stewra assistant thread.
E2E_CONTACT_NAME_A=QA Web A

# The dedicated QA Google account that user A connects on production (Calendar +
# Gmail scopes). Address only — its password is not needed by any automated test.
E2E_QA_GMAIL=robinstyle501@gmail.com

# Skip budget for the main production suite (skip-reporter.mjs): exactly the six
# conditional-by-design skips as of 2026-08-13 — sign-up UI (opt-in, creates a
# permanent account), runner session (needs a paired runner online), re-consent
# banner (only when a connection needs re-consent) — each across two browser
# profiles. Any new skip fails the run. A real env var overrides this (CI pins
# the commerce suite to 0 that way).
E2E_MAX_SKIPS=6
