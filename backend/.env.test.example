# Backend TEST env — copy to backend/.env.test. NEVER commit real secrets.
#
# The backend suite is not simulated: it talks to a real Postgres and a real Redis, because a test
# that only proves a stub was called proves nothing about the query or the key it would really run.
# Both live on `stewra-server` and are reached through `npm run tunnel` (from the repo root).
#
# One-time setup of the test database, run on the server as the postgres superuser:
#
#   docker exec -i postgres psql -U "$POSTGRES_USER" -d postgres <<'SQL'
#   CREATE ROLE stewra_test LOGIN PASSWORD 'pick-a-password';
#   CREATE DATABASE stewra_test OWNER stewra_test;
#   SQL
#
# then, locally, with this file in place:
#
#   npm run tunnel          # repo root: local 5433 -> postgres, local 6379 -> stewra-redis-1
#   cd backend && set -a && . ./.env.test && set +a && npm run db:migrate
#
# It MUST be a database of its own. The suite inserts and deletes rows freely, so pointing this at
# the `stewra` dev database would destroy real data.

NODE_ENV=test

# The dedicated test database — never the dev/prod `stewra` one.
DATABASE_URL=postgresql://stewra_test:CHANGE_ME@127.0.0.1:5433/stewra_test

# Redis database 15 on the shared instance. The app uses db 0; keeping the suite on its own index
# means a test flush can never wipe live keys.
REDIS_URL=redis://127.0.0.1:6379/15

# Throwaway values — these guard nothing, but the config schema validates their shape, so they have
# to be well-formed. Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_at_least_32_characters_long
VAULT_KEY=CHANGE_ME_64_hex_chars

WEB_APP_URL=http://127.0.0.1:3000

# No test reaches Google; these only have to parse.
GOOGLE_CLIENT_ID=test.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/api/connections/google/callback
GMAIL_LOOKBACK_DAYS=7

# No test opens an SMTP connection either.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=stewra-test
SMTP_PASSWORD=CHANGE_ME
EMAIL_FROM=test@stewra.invalid

# Operator account for the platform rate-card routes; the commerceRates suite registers this user.
INSTALL_ADMIN_EMAILS=install-admin@stewra.test,spend-cap-admin@stewra.test,billing-admin@stewra.test,payments-admin@stewra.test,manual-billing-admin@stewra.test

# ── Stripe, TEST MODE ONLY — optional ────────────────────────────────────────────────────────────
#
# Leave these blank and everything still runs. The backend suite covers Stripe against a scripted
# stand-in (`commercePayments.test.ts` points STRIPE_API_BASE_URL at a local server), and the
# browser suite's billing spec covers plan, collector, invoicing and store suppression on the
# `manual` provider.
#
# What they unlock is the one thing neither of those can reach: a card actually typed into Stripe's
# iframe. That field is served by js.stripe.com and confirmed by Stripe's own script against the
# publishable key, so it cannot be pointed at a stand-in and a fake key is rejected before it
# renders. With all three set, `npm run test:e2e:stripe` (in website/e2e) puts a 4242 card on file
# through the page and lets the real scheduler collect a real $149 test-mode invoice.
#
# All three or none — a publishable key with no secret renders a card form whose confirmation the
# server cannot verify. The stack refuses a partial set, and refuses any key that is not test mode:
# these suites charge invoices, and the `_test_` infix is the only thing separating that from real
# money on a real account.
#
# From the Stripe dashboard in test mode: Developers → API keys for the first two, and
# `stripe listen --forward-to <api>/webhooks/payments` prints the third.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
